# Copy to frontend/.env.local (git-ignored). Both values are optional and default to the ones shown.

# API base path as seen by the BROWSER. Keep it relative: requests then go through the Vite proxy and stay
# same-origin, which the SameSite=Strict session cookie depends on.
VITE_API_BASE_URL=/api

# Where `npm run dev` / `npm run preview` forward /api to. Read by vite.config.ts only, never bundled into
# browser code.
BTS_API_PROXY_TARGET=http://localhost:8080
