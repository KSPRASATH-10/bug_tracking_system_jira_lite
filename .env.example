# Copy to .env (git-ignored) before running `docker compose up -d`.
# The values below are LOCAL DEVELOPMENT ONLY. Generate fresh secrets for any shared environment:
#   openssl rand -base64 48

# ---- PostgreSQL ----
BTS_DB_NAME=bts
BTS_DB_USER=bts_app
BTS_DB_PASSWORD=bts_local_dev_Pg16_pw
BTS_DB_PORT=5432

# ---- Backend (read by Spring Boot via environment variables) ----
BTS_DB_URL=jdbc:postgresql://localhost:5432/bts
# HMAC-SHA256 signing key. Startup fails if shorter than 32 bytes.
BTS_JWT_SECRET=dev-only-jira-lite-signing-key-0123456789-abcdefghij
BTS_JWT_TTL_MINUTES=30
# Secure cookies are accepted on http://localhost by Chrome/Edge/Firefox. Never set false outside local dev.
BTS_COOKIE_SECURE=true
BTS_CORS_ALLOWED_ORIGIN=http://localhost:5173
BTS_UPLOAD_DIR=./var/uploads
